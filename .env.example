# ======================================================================
# Multi-Tenant Aggregation Layer — configuration
# Copy to .env:  cp .env.example .env
# Change ONLY this file. Never change the code.
# ======================================================================

# Postgres (main database = source of truth)
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon
POSTGRES_PORT=5432

# Redis (query cache — optional; system works without it)
REDIS_PORT=6379

# API
API_PORT=8000

# Refresh worker — adaptive intervals (no fixed 10s overkill)
# ACTIVE_POLL_SEC: how fast to re-poll after finding changes (default 2s)
# IDLE_POLL_SEC:   how often to poll when nothing has changed (default 5s)
ACTIVE_POLL_SEC=2
IDLE_POLL_SEC=5

# Batch size per worker pass (tune down if memory is tight on a laptop)
REFRESH_BATCH_SIZE=50000

# Redis cache TTL (seconds) — generation-based invalidation is primary
CACHE_TTL_SEC=30

# Per-tenant concurrent query limit (Bonus B-3)
MAX_CONCURRENT_QUERIES_PER_TENANT=4

# Data location — change to ./out_main for the full 10M run
HOST_DATA_DIR=./out_small
DATA_DIR=/data
